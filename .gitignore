# OpenTofu / Terraform directories
**/.terraform/*

# .tfstate files
*.tfstate
*.tfstate.*

# Crash log files
crash.log
crash.*.log

# Exclude all .tfvars files and local secrets summary, which contain sensitive keys
*.tfvars
*.tfvars.json
.github-secrets.txt

# Ignore override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Ignore CLI configuration files
.terraformrc
terraform.rc
.tofurc
tofu.rc


# Local AI agent instructions
CLAUDE.md
AGENTS.md
